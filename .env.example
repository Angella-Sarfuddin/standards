# MySQL catalogue (required). Example shape only — use real credentials locally.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE

# Optional comma-separated browser origins for Boss / other frontends.
# localhost and 127.0.0.1 (http/https, any port) are already allowed by default.
# CORS_ORIGINS=https://boss.example.com,https://localhost:5173
